# NetVault Server — variables de entorno
# Copiar a .env y completar antes de iniciar

# Puerto del servidor (default 3847)
PORT=3847

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_CLAVE_ALEATORIA_DE_64_BYTES
JWT_EXPIRES_IN=8h

# Claude API key (NUNCA poner esta key en el cliente .exe)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a usar
CLAUDE_MODEL=claude-opus-4-5

# Usuarios demo (para MVP; reemplazar con SSO/LDAP en producción)
# Formato: usuario:password:rol  separados por coma
DEMO_USERS=admin:admin123:aprobador_maximo,analista:analista123:analista,lector:lector123:lector

# CORS — origins permitidos (separados por coma)
# Para desarrollo Electron: app://. — Para producción restringir
CORS_ORIGINS=app://.,http://localhost:5173

# Intranet webhook URL (para POST /ingest/documento)
INTRANET_URL=https://tu-intranet.zymo.app
INTRANET_HMAC_SECRET=CAMBIA_ESTO_POR_SECRETO_HMAC
