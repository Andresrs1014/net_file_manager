NODE_ENV=development
PORT=3847

# Clave de Anthropic — requerida para análisis real (sin esto corre en modo mock)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a usar (default: claude-opus-4-5-20251001)
# CLAUDE_MODEL=claude-opus-4-5-20251001

# JWT para autenticación del servidor NetVault (independiente de la intranet)
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# Usuarios demo: usuario:contraseña:rol (roles: aprobador_maximo | analista | lector)
# DEMO_USERS=admin:admin123:aprobador_maximo,analista:analista123:analista

# CORS — separar con comas si hay múltiples orígenes
CORS_ORIGINS=app://.,http://localhost:5173

# URL de la intranet ZYMO (opcional — para integraciones futuras)
# INTRANET_URL=https://zymointranet.com
# INTRANET_HMAC_SECRET=
