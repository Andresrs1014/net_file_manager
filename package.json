{
  "name": "netvault",
  "version": "1.0.0",
  "description": "Gestor de archivos con doble panel, terminal integrada, búsqueda indexada e IA con Ollama",
  "main": "dist-electron/main.js",
  "author": "Andrés Quintero",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"npm run build:electron:watch\" \"wait-on tcp:5173 && electron .\"",
    "server:dev": "npm run dev --prefix server",
    "dev:analysis": "concurrently -k \"npm run server:dev\" \"npm run electron:dev\"",
    "electron:build": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "dist:info": "node scripts/build-info.js",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.4.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.8.0",
    "mermaid": "^11.4.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
